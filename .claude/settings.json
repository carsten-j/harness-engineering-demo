{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ],
    "allow": [
      "Bash(make test*)",
      "Bash(make check*)",
      "Bash(make migrate*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[(now|todate), .session_id, .tool_input.skill, (.tool_input.args // \"\")] | @tsv' >> \"$CLAUDE_PROJECT_DIR/.claude/skill-usage.log\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/build-throttle.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "uv run ruff check . >&2 || exit 2" }
        ]
      }
    ]
  }
}
